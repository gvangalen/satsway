{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer expo run:ios",
    "web": "expo start --web",
